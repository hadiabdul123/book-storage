{
  "name": "leafmark-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "pretest": "node scripts/prepare-dictionary.mjs",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.production.config.ts",
    "test:private": "playwright test --config playwright.private.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/literata": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "dompurify": "^3.2.7",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
